# Copy to `.env` and fill in. `.env` is git-ignored — never commit real credentials.
#
# Switching environments is a single change: set FLYWIRE_ENVIRONMENT.
# Credentials are resolved as FLYWIRE_<ENV>_<NAME> first, then FLYWIRE_<NAME>,
# so you can keep both credential sets side by side and just flip this value.
# sandbox | production
FLYWIRE_ENVIRONMENT=sandbox

# --- Sandbox credentials (from the Flywire Solutions team) ---
FLYWIRE_SANDBOX_API_KEY=
FLYWIRE_SANDBOX_SHARED_SECRET=
FLYWIRE_SANDBOX_FRONTEND_KEY=
FLYWIRE_SANDBOX_RECIPIENT_ID=

# --- Production credentials ---
FLYWIRE_PRODUCTION_API_KEY=
FLYWIRE_PRODUCTION_SHARED_SECRET=
FLYWIRE_PRODUCTION_FRONTEND_KEY=
FLYWIRE_PRODUCTION_RECIPIENT_ID=

# --- Optional, shared or per-environment (FLYWIRE_SANDBOX_NOTIFICATIONS_URL etc. also work) ---
# Public HTTPS URL of your webhook endpoint (overrides the static callback URL for API integrations).
FLYWIRE_NOTIFICATIONS_URL=
FLYWIRE_TIMEOUT_SECONDS=30
FLYWIRE_MAX_RETRIES=2

# ─── Payment gateway (multi-site service) ─────────────────────────────────────
# Public base URL of the gateway (https in production; http://localhost for dev).
GATEWAY_PUBLIC_URL=http://localhost:8080
# Signs payment links. Generate: python -m flywire_checkout.gateway new-key
GATEWAY_SECRET=
GATEWAY_SITES_FILE=sites.toml
GATEWAY_DB_PATH=data/gateway.db
GATEWAY_CHECKOUT_TTL_HOURS=24

# Per-site keys — names come from sites.toml (api_key_env / webhook_secret_env).
# Generate each with: python -m flywire_checkout.gateway new-key
SITE_LOCAL_DEMO_API_KEY=
SITE_LOCAL_DEMO_WEBHOOK_SECRET=
